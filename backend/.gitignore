# Delete the old one
del .gitignore

# Create new .gitignore
echo "# Dependencies" > .gitignore
echo "node_modules/" >> .gitignore
echo "backend/node_modules/" >> .gitignore
echo "frontend/node_modules/" >> .gitignore
echo "" >> .gitignore
echo "# Environment files" >> .gitignore
echo ".env" >> .gitignore
echo "*.env" >> .gitignore
echo "" >> .gitignore
echo "# Logs" >> .gitignore
echo "*.log" >> .gitignore
echo "npm-debug.log*" >> .gitignore
echo "" >> .gitignore
echo "# Database files (optional - remove if you want to include them)" >> .gitignore
echo "*.db" >> .gitignore
echo "backend/data/*.db" >> .gitignore
echo "" >> .gitignore
echo "# OS files" >> .gitignore
echo ".DS_Store" >> .gitignore
echo "Thumbs.db" >> .gitignore